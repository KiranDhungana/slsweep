NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://slsweepofficial.com

# Must match REVALIDATE_SECRET in the backend .env
REVALIDATE_SECRET=change-me-to-another-long-secret

# Optional: Google Search Console verification code (content of the meta tag)
GSC_VERIFICATION=
# Optional: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
GA_MEASUREMENT_ID=
# Optional: Bing Webmaster verification code
NEXT_PUBLIC_BING_SITE_VERIFICATION=
